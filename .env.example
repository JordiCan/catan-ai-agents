# Copy this file to `.env` and fill in only the variables you need.

CATAN_LLM_ENABLED=1
CATAN_LLM_PROVIDER=poligpt
CATAN_LLM_MODEL=openai/poligpt
CATAN_LLM_PROMPT=strict_json
CATAN_LLM_LOG_PATH=artifacts/llm_decisions.jsonl
CATAN_LLM_TIMEOUT_SECONDS=20

# Poligpt
POLIGPT_KEY=your_poligpt_key_here

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Bedrock
BEDROCK_KEY=your_bedrock_bearer_token_here
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_optional_aws_session_token_here
AWS_DEFAULT_REGION=us-east-1
